/**
 * secrets.h — EXAMPLE
 *
 * Copy this file to `secrets.h` in the same directory, then fill in your
 * own WiFi credentials and the IP of the laptop running the Flask server.
 *
 * `secrets.h` is listed in .gitignore — never commit your real credentials.
 */

#pragma once

// Your local WiFi network
#define WIFI_SSID   "your_wifi_ssid_here"
#define WIFI_PASS   "your_wifi_password_here"

// IP and port of the laptop running server/app.py
// On Windows:  ipconfig    →    IPv4 Address
// On macOS:    ifconfig    →    inet
// On Linux:    ip addr     →    inet
#define FLASK_IP    "192.168.1.100"
#define FLASK_PORT  5000
